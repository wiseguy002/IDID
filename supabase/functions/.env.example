# Secrets for Supabase Edge Functions. Copy to supabase/functions/.env for local use
# (that file is git-ignored). In production, set them with `supabase secrets set` (docs/SETUP.md).

# Resend API key: https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=re_your_api_key_here
# Sender shown on emails. The domain must be verified in Resend.
EMAIL_FROM="iDID <idid@beepboopmail.com>"

# Web Push (see docs/SETUP.md, step 4)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@idid.care
CRON_SECRET=
