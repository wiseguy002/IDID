# Copy to .env.local for local development with an online circle.
# These are public values (the anon key is safe in the browser; access is enforced by row-level security).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# From `npx web-push generate-vapid-keys` (public half only).
VITE_VAPID_PUBLIC_KEY=
# Optional: Cloudflare Turnstile site key for the sign-in check (public). Leave empty to turn it off.
VITE_TURNSTILE_SITE_KEY=
